# Nur für `npm start` (CRA-Dev-Server). Socket.io direkt ans Backend statt über den CRA-Proxy:
# der Proxy des `proxy`-Felds stirbt mit unbehandeltem ECONNRESET, sobald eine WebSocket-Verbindung
# abreißt (z.B. bei jedem nodemon-Neustart des Backends), und reißt den Dev-Server mit.
REACT_APP_WS_URL=http://localhost:3001
