# Database
DB_USER=clubtouch3
DB_PASSWORD=secure_password_here
DB_NAME=clubtouch3

# Backend (development im LAN ohne HTTPS; production verlangt echte Secrets und SEED_ADMIN_*)
BACKEND_NODE_ENV=development
# Pflicht, mindestens 32 Zeichen, je Secret ein eigener Zufallswert: openssl rand -hex 32
JWT_SECRET=HIER_ZUFALLSWERT_EINTRAGEN
JWT_REFRESH_SECRET=HIER_ANDEREN_ZUFALLSWERT_EINTRAGEN
JWT_EXPIRE_TIME=15m
JWT_REFRESH_EXPIRE_TIME=7d
BCRYPT_ROUNDS=10
# Gemeinsamer PIN fuer die oeffentliche Guthaben-Abfrage (/check-balance), Standard 666
# PUBLIC_BALANCE_PIN=666

# Erster Admin (wird nur angelegt, solange es keinen Benutzer gibt; mit BACKEND_NODE_ENV=production Pflicht)
# SEED_ADMIN_EMAIL=admin@example.org
# SEED_ADMIN_PASSWORD=

# URLs
PUBLIC_FRONTEND_URL=http://localhost
# WEB_PORT=80
# API_PORT=3001
# DB_PORT=5432

# Uploads (optional): Ablageordner fuer Artikelbilder, Belegnachweise und Werbung.
# Standard: <Arbeitsverzeichnis>/uploads bzw. RAILWAY_VOLUME_MOUNT_PATH auf Railway.
# UPLOADS_DIR=/app/uploads
